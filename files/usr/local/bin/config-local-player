#!/bin/bash

if [ -z "$(whoami | grep root)" ]; then
    echo "Not running as root."
    exit
fi

if [ ! -f /etc/default/squeezelite ]; then
    exit
fi

rm -f /etc/default/squeezelite

if [ "$1" != "" ]; then
    echo "SL_NAME=\"LocalPlayer\"" >> /etc/default/squeezelite
    echo "SB_SERVER_IP=\"localhost\"" >> /etc/default/squeezelite    
    echo "SL_SOUNDCARD=\"$1\"" >> /etc/default/squeezelite
fi 

start-stop-local-player

